{
  "name": "cat-grok-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm build:rtc && node scripts/build.mjs",
    "build:rtc": "node scripts/build-rtc.mjs",
    "start:voice": "node server/index.mjs",
    "test": "node --test",
    "weekly:generate": "node scripts/generate-weekly-report.mjs",
    "validate": "node scripts/validate-content.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "pnpm validate && pnpm test && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@volcengine/openapi": "1.36.2",
    "gray-matter": "4.0.3",
    "markdown-it": "14.3.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@volcengine/rtc": "4.69.1",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
